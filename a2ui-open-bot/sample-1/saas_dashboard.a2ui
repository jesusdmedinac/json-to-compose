root = Column([head, actions_row, kpis, chart_section, accounts_table, follow_ups], gap=4)
head = Heading("Q3 Executive SaaS Performance", eyebrow="Financial Performance", subtitle="Recurring revenue up 18% YoY with sustained net expansion across enterprise tiers")
btn_export = Button("Export Report", icon="download", onClick=Event("export_report"))
btn_qbr = Button("Schedule QBR", variant="primary", icon="calendar", onClick=Event("schedule_qbr"))
actions_row = Row([btn_export, btn_qbr], gap=2, justify="end")
stat_arr = Stat("Annual Recurring Revenue", "$14.2M", delta="+18%", trend="up", caption="vs Q3 last year", tone="positive")
stat_nrr = Stat("Net Retention Rate", "118%", delta="+4%", trend="up", caption="Target: 115%", tone="positive")
stat_accounts = Sparkline("Active Enterprise Accounts", [380, 392, 405, 412, 416, 420], value="420", delta="+10 accounts", tone="positive")
kpis = Grid([stat_arr, stat_nrr, stat_accounts], columns=3, gap=3)
chart_section = AreaChart(title="Monthly Recurring Revenue by Region", subtitle="Monthly recurring revenue distribution in thousands (USD)", height=280, format="currency", stacked=true, data=[{x: "Jul", y: 720, series: "North America"}, {x: "Jul", y: 440, series: "EMEA"}, {x: "Aug", y: 750, series: "North America"}, {x: "Aug", y: 460, series: "EMEA"}, {x: "Sep", y: 790, series: "North America"}, {x: "Sep", y: 490, series: "EMEA"}])
accounts_table = DataTable("Enterprise Key Accounts", [{"key": "name", "label": "Client Name"}, {"key": "tier", "label": "Tier"}, {"key": "arr", "label": "ARR", "format": "currency"}, {"key": "health", "label": "Health Status"}, {"key": "renewal", "label": "Renewal Date"}], [{"name": "Acme Global", "tier": "Strategic", "arr": "$420,000", "health": "Healthy", "renewal": "2024-11-15"}, {"name": "NovaTech Labs", "tier": "Enterprise", "arr": "$280,000", "health": "Healthy", "renewal": "2024-12-01"}, {"name": "Helix Systems", "tier": "Enterprise", "arr": "$310,000", "health": "At Risk", "renewal": "2024-10-31"}, {"name": "Vanguard Media", "tier": "Strategic", "arr": "$540,000", "health": "Healthy", "renewal": "2025-01-20"}])
follow_ups = FollowUp([{"label": "Inspect churn risk accounts", "message": "Show me a detailed breakdown of accounts currently flagged at churn risk."}])

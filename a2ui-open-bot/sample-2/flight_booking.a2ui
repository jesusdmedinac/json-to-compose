root = Column([head, flight_summary, route_section, booking_card, follow_ups], gap=4)
head = Heading("Confirm Your Flight Booking", subtitle="Review your itinerary and select cabin class before checkout", level="1")
flight_summary = FlightCard("Pacific Airways", "PA 842", "SFO", "NRT", "San Francisco", "Tokyo", "11:15 AM", "07:45 PM (+1)", "15h 30m", "1 stop", "$1,180", "Economy", "May 18, 2025", "Best Value", "Select Flight", Event("select_flight"))
route_section = Section(title="Flight Schedule & Layover", description="Complete itinerary including transfer details", children=[itinerary_timeline])
itinerary_timeline = Timeline([{"title": "Depart San Francisco (SFO)", "description": "Flight PA 842 to Honolulu - Boeing 787-9", "date": "11:15 AM", "status": "completed"}, {"title": "Layover in Honolulu (HNL)", "description": "1h 30m connection time - Terminal 2 transfer", "date": "02:45 PM", "status": "in_progress"}, {"title": "Depart Honolulu (HNL)", "description": "Flight PA 843 to Tokyo Narita - Airbus A350", "date": "04:15 PM", "status": "pending"}, {"title": "Arrive Tokyo Narita (NRT)", "description": "Terminal 1 International Arrivals", "date": "07:45 PM (+1)", "status": "pending"}])
booking_card = Card([cabin_selector, divider_line, price_breakdown, pay_btn], variant="elevated", size="md", gap=4)
cabin_selector = SegmentedControl("Cabin Class", [{"label": "Economy", "value": "economy"}, {"label": "Premium Economy", "value": "premium"}, {"label": "Business", "value": "business"}], $/booking/cabin)
divider_line = Divider()
price_breakdown = KeyValueList("Fare Summary", [{"label": "Base Fare (Adult x 1)", "value": "$980.00"}, {"label": "Taxes & Airport Security Fees", "value": "$142.50"}, {"label": "Fuel Surcharge", "value": "$57.50"}, {"label": "Total Amount", "value": "$1,180.00"}])
pay_btn = Button("Confirm & Pay $1,180", onClick=Event("confirm_booking"), variant="primary", block=true)
follow_ups = FollowUp([{"label": "Baggage allowance", "message": "What is the baggage allowance for this flight?"}, {"label": "Seat selection", "message": "Can I select my seats now?"}], title="Need additional details?")
$/booking/cabin = "economy"
